# Othello Platform 生产环境变量模板
# 用法：cp .env.prod.example .env  →  务必修改 JWT_SECRET  →  docker compose -f docker-compose.prod.yml up -d --build
# .env 已被 gitignore，不会入库。

# ===== 数据库（compose 内部 DNS，服务名 postgres）=====
DATABASE_URL=postgres://othello:othello@postgres:5432/othello
# 以下三项供 compose 创建 postgres 容器用，须与 DATABASE_URL 中的账号一致
POSTGRES_USER=othello
POSTGRES_PASSWORD=othello
POSTGRES_DB=othello

# ===== JWT（必填：请改为高强度随机串，如 openssl rand -hex 32）=====
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_TTL=1d
JWT_REFRESH_TTL=30d

# ===== 服务监听 =====
PORT=3000
HOST=0.0.0.0
WS_PATH=/ws

# ===== CORS / 代理 =====
# 经 nginx 同源反代时前端与 API 同源，CORS 可保持默认；若前后端分离部署则填前端域名
CORS_ORIGINS=http://localhost
# 位于反向代理（nginx）之后，置 true 使限流按真实客户端 IP 生效
TRUST_PROXY=true

# ===== AI =====
AI_MAX_WORKERS=4
AI_THINK_BUDGET_MS=5000

# ===== 对局计时 =====
MOVE_TIMEOUT_MS=30000
RECONNECT_WINDOW_MS=30000
SHUTDOWN_TIMEOUT_MS=10000

# ===== 限流（@fastify/rate-limit）=====
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=1 minute
RESET_RATE_LIMIT_MAX=5
RESET_RATE_LIMIT_WINDOW=1 minute

# ===== 邮件（v1: stub，令牌打印到日志）=====
MAIL_FROM=noreply@othello-platform.local

# ===== 日志 =====
LOG_LEVEL=info

# ===== 前端端口（compose 变量，宿主机暴露端口，默认 80）=====
WEB_PORT=80
