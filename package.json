{
  "name": "othello-platform",
  "version": "0.1.0",
  "private": true,
  "description": "全栈黑白棋（Othello/Reversi）对战平台：服务端权威对战、AI 人机、复盘、观战、题库与赛季段位",
  "license": "MIT",
  "author": "Hex",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hex-ci/othello-platform.git"
  },
  "homepage": "https://github.com/hex-ci/othello-platform#readme",
  "bugs": {
    "url": "https://github.com/hex-ci/othello-platform/issues"
  },
  "keywords": [
    "othello",
    "reversi",
    "board-game",
    "multiplayer",
    "websocket",
    "vue3",
    "fastify",
    "typescript"
  ],
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "build": "run-s code-check build-only",
    "build-only": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . --cache --max-warnings 0",
    "lint:fix": "eslint . --cache --max-warnings 0 --fix",
    "test": "pnpm -r test",
    "dev": "run-p dev:web dev:server",
    "dev:web": "pnpm --filter @othello-platform/web dev",
    "dev:server": "pnpm --filter @othello-platform/server dev",
    "migrate:up": "pnpm --filter @othello-platform/server migrate:up",
    "migrate:down": "pnpm --filter @othello-platform/server migrate:down",
    "code-check": "run-p typecheck lint",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@intlify/unplugin-vue-i18n": "^11.2.4",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tsconfig/node22": "^22.0.5",
    "@types/node": "^22.20.1",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.8.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "npm-run-all2": "^9.0.3",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3"
  }
}
