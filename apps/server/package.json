{
  "name": "@othello-platform/server",
  "version": "0.1.0",
  "private": true,
  "description": "Othello Platform 后端：Fastify 5 + ws + PostgreSQL（服务端权威对战、AI 线程池、鉴权）",
  "license": "MIT",
  "author": "Hex",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hex-ci/othello-platform.git",
    "directory": "apps/server"
  },
  "homepage": "https://github.com/hex-ci/othello-platform#readme",
  "bugs": {
    "url": "https://github.com/hex-ci/othello-platform/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "start": "node --env-file=.env dist/index.js",
    "test": "vitest run --passWithNoTests",
    "loadtest": "tsx --env-file=.env scripts/ws-load-test.ts",
    "migrate:up": "tsx --env-file=.env src/db/migrate.ts up",
    "migrate:down": "tsx --env-file=.env src/db/migrate.ts down"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.1",
    "@fastify/rate-limit": "^11.1.0",
    "@othello-platform/engine": "workspace:*",
    "@othello-platform/shared": "workspace:*",
    "argon2": "^0.45.1",
    "fastify": "^5.10.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "ws": "^8.21.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/pg": "^8.20.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
