# Database
DATABASE_URL=postgres://othello:***@localhost:5432/othello

# JWT
JWT_SECRET=othello
JWT_ACCESS_TTL=1d
JWT_REFRESH_TTL=30d

# WebSocket
WS_PATH=/ws

# AI
AI_MAX_WORKERS=4

# Mail (v1: stub, tokens logged to console)
MAIL_FROM=noreply@othello-platform.local

# Logging
LOG_LEVEL=info

# Server
PORT=3000
HOST=0.0.0.0

# Rate Limit（@fastify/rate-limit）
# 全局：已登录用户按 userId 限流，未登录回退 IP。阈值按需调。
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute
# 鉴权敏感端点（登录/注册/刷新）：防爆破，按 IP 限流（这些端点无 token）。
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW=1 minute
# 密码重置/邮箱验证：更严，防爆破。
RESET_RATE_LIMIT_MAX=5
RESET_RATE_LIMIT_WINDOW=1 minute
